<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/plum"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="56dp"
        android:paddingBottom="40dp">

        <!-- Kepala halaman -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Loket 03"
            android:textColor="@color/marigold"
            android:textSize="13sp"
            android:letterSpacing="0.12"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Malam Wayang Kontemporer"
            android:textColor="@color/cream"
            android:textSize="30sp"
            android:lineSpacingExtra="2dp"
            android:fontFamily="sans-serif-condensed-medium" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Sabtu, 3 Oktober · Gedung Kesenian Cakrawala"
            android:textColor="@color/cream_muted"
            android:textSize="14sp" />

        <!-- Kartu tiket -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical"
            android:background="@drawable/bg_tiket">

            <!-- Bagian atas: harga -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom"
                android:padding="24dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Harga satu tiket"
                        android:textColor="@color/ink_muted"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_harga"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Rp 35.000"
                        android:textColor="@color/ink"
                        android:textSize="26sp"
                        android:fontFamily="sans-serif-condensed-medium" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_label_kelas"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="Kelas Festival"
                    android:textColor="@color/plum"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- Pengatur jumlah -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jumlah tiket"
                    android:textColor="@color/ink_muted"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageButton
                        android:id="@+id/btn_kurang"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_tombol_bulat"
                        android:src="@drawable/ic_kurang"
                        android:contentDescription="Kurangi satu tiket"
                        android:scaleType="center" />

                    <TextView
                        android:id="@+id/tv_jumlah"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="@color/ink"
                        android:textSize="44sp"
                        android:fontFamily="sans-serif-condensed-medium" />

                    <ImageButton
                        android:id="@+id/btn_tambah"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_tombol_bulat"
                        android:src="@drawable/ic_tambah"
                        android:contentDescription="Tambah satu tiket"
                        android:scaleType="center" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_catatan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="Sisa kuota 5 tiket lagi"
                    android:textColor="@color/ink_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Garis sobek + lekukan kiri-kanan -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="-11dp"
                    android:background="@drawable/bg_lekukan" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="10dp"
                    android:layerType="software"
                    android:background="@drawable/garis_putus" />

                <View
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="-11dp"
                    android:background="@drawable/bg_lekukan" />
            </LinearLayout>

            <!-- Bagian bawah: total -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Total bayar"
                    android:textColor="@color/ink_muted"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rp 35.000"
                    android:textColor="@color/plum"
                    android:textSize="30sp"
                    android:fontFamily="sans-serif-condensed-medium" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/btn_reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_tombol_reset"
            android:paddingHorizontal="28dp"
            android:paddingVertical="14dp"
            android:text="Mulai ulang pesanan"
            android:textColor="@color/cream"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</ScrollView>